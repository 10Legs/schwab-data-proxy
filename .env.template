# Required — Market data app credentials
SCHWAB_DATA_CLIENT_ID=your_app_key_here
SCHWAB_DATA_CLIENT_SECRET=your_app_secret_here
# Must match the callback URL registered in your Schwab developer app.
# This is a URL on your HOST machine (not inside the container) — the port here
# has no relation to the proxy port (8080). Schwab requires https://.
SCHWAB_DATA_CALLBACK_URL=https://127.0.0.1:8182/

# Token path inside the Docker volume — do not change unless you remap the volume mount
SCHWAB_DATA_TOKEN_PATH=/data/token.json

# Optional — separate Schwab Trader API app (required for streaming if your main
# app only has Market Data Production subscribed).
# If set, streaming uses these credentials. If unset, streaming falls back to
# SCHWAB_DATA_CLIENT_ID / SCHWAB_DATA_CLIENT_SECRET (works if your app has both products).
SCHWAB_TRADER_CLIENT_ID=
SCHWAB_TRADER_CLIENT_SECRET=
# Must match the callback URL registered in your Trader API Schwab developer app.
# Falls back to SCHWAB_DATA_CALLBACK_URL if unset.
SCHWAB_TRADER_CALLBACK_URL=https://127.0.0.1:8182/
# Token path for the trader API token inside the Docker volume
SCHWAB_TRADER_TOKEN_PATH=/data/trader_token.json

# Optional overrides
PORT=8080
CACHE_TTL_SECONDS=2
LOG_LEVEL=INFO

# API key required by all downstream clients (REST: X-API-Key header; WS: ?api_key= param).
# Leave empty to disable authentication (trusted network / local dev only).
PROXY_API_KEY=
